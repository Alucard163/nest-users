    {
      "name": "Avatars",
      "item": [
        {
          "name": "Upload Avatar",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const jsonData = pm.response.json();",
                  "    pm.environment.set(\"avatar_id\", jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/profile/avatars",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "profile",
                "avatars"
              ]
            },
            "description": "Загрузка аватара текущего пользователя (multipart/form-data, поле file)"
          },
          "response": []
        },
        {
          "name": "Delete Avatar",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/profile/avatars/{{avatar_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "profile",
                "avatars",
                "{{avatar_id}}"
              ]
            },
            "description": "Удаление аватара (soft delete). Требуется avatar_id из Upload Avatar"
          },
          "response": []
        }
      ]
    },
