PORT=3000
NOTIFICATION_PORT=3001
NODE_ENV=development
DATABASE_URL="postgresql://nest:nest@localhost:5432/nestdb?schema=public"
# JWT Configuration
JWT_ACCESS_SECRET=dev_access_secret_key_change_in_production
JWT_REFRESH_SECRET=dev_refresh_secret_key_change_in_production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=main
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000

REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=redis_password_change_me

KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=users-app
NOTIFICATION_KAFKA_CLIENT_ID=notification-service
NOTIFICATION_KAFKA_GROUP_ID=notification-service-consumer

MONGO_URI=mongodb://localhost:27017/notification_service
